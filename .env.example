# Accounts are connected from the app: tap Gmail, Outlook, Teams, Slack or iMessage at the top of the page.
# Optional: limit which account types the app offers (default: all of them)
# CONNECTORS=gmail,outlook,teams,slack,imessage

# Claude (extraction, brief writing, and decisions until Jev is wired in)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Model that reads every new email (small and fast keeps it cheap)
READER_MODEL=claude-haiku-4-5

# Decisions: "claude" now, "jev" once you have Jev API access
DECISION_BACKEND=claude
JEV_API_KEY=

# Not needed any more: the Connect screens save these for you in secrets/
# GMAIL_CREDENTIALS=secrets/gmail_credentials.json
# MS_CLIENT_ID=
# SLACK_USER_TOKEN=

# Morning brief delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Tuning
# How often to check email, Slack and calendar (minutes, 0 = only when you press Sync)
AUTO_SYNC_MINUTES=5
LOOKBACK_DAYS=3
WAITING_DAYS=3
AUTO_CLOSE_THRESHOLD=0.9
CONFIRM_THRESHOLD=0.6
