# Which sources to sync (comma separated): gmail,outlook,slack
CONNECTORS=gmail,outlook,slack

# Claude (extraction, brief writing, and decisions until Jev is wired in)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Decisions: "claude" now, "jev" once you have Jev API access
DECISION_BACKEND=claude
JEV_API_KEY=

# Gmail: OAuth client file downloaded from Google Cloud (Desktop app)
GMAIL_CREDENTIALS=secrets/gmail_credentials.json

# Outlook: Application (client) ID from your Azure app registration
MS_CLIENT_ID=

# Slack: user token (starts xoxp-) from your Slack app
SLACK_USER_TOKEN=

# Morning brief delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Tuning
LOOKBACK_DAYS=3
WAITING_DAYS=3
AUTO_CLOSE_THRESHOLD=0.9
CONFIRM_THRESHOLD=0.6
